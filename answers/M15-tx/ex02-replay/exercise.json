  "answers": [
    {
      "q": "Replaying a write-ahead log recovers what after a crash?",
      "a": "state"
    },
    {
      "q": "When two logged writes touch the same key, which one wins?",
      "a": "the later one"
    },
    {
      "q": "The log is written before a change is considered durable; it is therefore what style of log?",
      "a": "write-ahead"
    }
  ],
