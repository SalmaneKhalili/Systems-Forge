{
  "id": "M17-ex05",
  "module": "M17-observability",
  "title": "telemetry",
  "lang": "go",
  "answers": [
    { "q": "A service that exposes live metrics over a network protocol is called a what?", "a": "telemetry gateway" },
    { "q": "The command that returns every metric as a sorted list is called what?", "a": "snap" },
    { "q": "The counter that grows by one each time a client connects is named what?", "a": "conn_total" }
  ],
  "methods": [
    {
      "type": "build",
      "build": { "make": "all" }
    },
    {
      "type": "net",
      "net": {
        "start": ["./test"],
        "port": 18530,
        "wait_ms": 700,
        "timeout_ms": 3000,
        "connections": [
          {
            "steps": [
              { "send": "INC http_ok 3\n", "expect": "ok\n" },
              { "send": "INC http_total 10\n", "expect": "ok\n" },
              { "send": "GET http_ok\n", "expect": "3\n" },
              { "send": "GET http_missing\n", "expect": "0\n" },
              { "send": "SNAP\n", "expect": "conn_total=1\nhttp_ok=3\nhttp_total=10\n" }
            ]
          },
          {
            "steps": [
              { "send": "GET conn_total\n", "expect": "2\n" },
              { "send": "INC http_ok 4\n", "expect": "ok\n" },
              { "send": "GET http_ok\n", "expect": "7\n" },
              { "send": "INC http_total 1\n", "expect": "ok\n" },
              { "send": "SNAP\n", "expect": "conn_total=2\nhttp_ok=7\nhttp_total=11\n" }
            ]
          }
        ]
      }
    },
    { "type": "quiz", "quiz": { "file": "quiz.txt" } }
  ]
}