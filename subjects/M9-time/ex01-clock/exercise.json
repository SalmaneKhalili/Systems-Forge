  "title": "lamport clock",
  "lang": "go",
  "answers": [
    {
      "q": "What does a Lamport clock assign to every event?",
      "a": "a counter"
    },
    {
      "q": "If a happened before b, how must Lamport(a) and Lamport(b) compare?",
      "a": "Lamport(a) < Lamport(b)"
    },
    {
      "q": "On receiving a message with stamp s, what rule updates the clock?",
      "a": "c = max(c, s) + 1"
    }
  ],
